# Normalize line endings, avoid Windows/Linux mixups breaking scripts.
# NOTE: keep comments ASCII-only; a non-ASCII comment without a trailing
# newline can swallow the next rule line and silently disable it.
* text=auto eol=lf

# PowerShell scripts use CRLF (Windows native), everything else LF.
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.sh    text eol=lf
*.py    text eol=lf
*.js    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf

# Binary assets: never apply text conversion.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff2 binary
*.zip   binary
*.tar   binary
*.gz    binary
