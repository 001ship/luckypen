# 统一换行符，避免 Windows/Linux 混用导致脚本失效
* text=auto eol=lf

*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.sh    text eol=lf
*.py    text eol=lf
*.js    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# 二进制
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff2 binary
